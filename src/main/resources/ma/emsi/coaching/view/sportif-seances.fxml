<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.emsi.coaching.controller.SportifSeancesController" spacing="16">
    <Label text="Mes séances" styleClass="titre-page"/>
    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100"/>
                    <TableColumn fx:id="colDuree" text="Durée" prefWidth="80"/>
                    <TableColumn fx:id="colRessenti" text="Ressenti" prefWidth="90"/>
                    <TableColumn fx:id="colCommentaire" text="Commentaire" prefWidth="250"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Label fx:id="resume" styleClass="texte-secondaire"/>
        </VBox>
        <VBox spacing="8" styleClass="panneau-formulaire" prefWidth="300" minWidth="300">
            <Label fx:id="titreFormulaire" text="Nouvelle séance" styleClass="titre-formulaire"/>
            <Label text="Date"/>
            <DatePicker fx:id="champDate"/>
            <Label text="Durée (minutes)"/>
            <TextField fx:id="champDuree"/>
            <Label text="Ressenti (1 = très difficile, 5 = excellent)"/>
            <ComboBox fx:id="comboRessenti"/>
            <Label text="Commentaire (facultatif)"/>
            <TextArea fx:id="champCommentaire" prefRowCount="3" wrapText="true"/>
            <Region prefHeight="6"/>
            <Button text="Enregistrer" styleClass="bouton-principal" maxWidth="Infinity" onAction="#enregistrer"/>
            <HBox spacing="8">
                <Button text="Nouvelle séance" styleClass="bouton-secondaire" maxWidth="Infinity"
                        HBox.hgrow="ALWAYS" onAction="#nouvelle"/>
                <Button fx:id="boutonSupprimer" text="Supprimer" styleClass="bouton-danger" maxWidth="Infinity"
                        HBox.hgrow="ALWAYS" onAction="#supprimer"/>
            </HBox>
        </VBox>
    </HBox>
</VBox>
