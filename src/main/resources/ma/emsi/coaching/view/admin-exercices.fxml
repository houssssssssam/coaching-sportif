<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.emsi.coaching.controller.AdminExercicesController" spacing="16">

    <Label text="Catalogue des exercices" styleClass="titre-page"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <HBox spacing="10" styleClass="barre-outils">
                <TextField fx:id="champRecherche" promptText="Rechercher (nom, groupe)" prefWidth="180" minWidth="-Infinity"/>
                <ComboBox fx:id="filtreType" prefWidth="150" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Nouvel exercice" styleClass="bouton-principal" minWidth="-Infinity" onAction="#nouveau"/>
            </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="200"/>
                    <TableColumn fx:id="colGroupe" text="Groupe musculaire" prefWidth="150"/>
                    <TableColumn fx:id="colType" text="Type" prefWidth="100"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox spacing="8" styleClass="panneau-formulaire" prefWidth="300" minWidth="300">
            <Label fx:id="titreFormulaire" text="Nouvel exercice" styleClass="titre-formulaire"/>
            <Label text="Nom"/>
            <TextField fx:id="champNom"/>
            <Label text="Groupe musculaire"/>
            <ComboBox fx:id="comboGroupe" editable="true"/>
            <Label text="Type"/>
            <ComboBox fx:id="comboType"/>
            <Label text="Description"/>
            <TextArea fx:id="champDescription" prefRowCount="4" wrapText="true"/>
            <Region prefHeight="6"/>
            <Button text="Enregistrer" styleClass="bouton-principal" maxWidth="Infinity" onAction="#enregistrer"/>
            <Button fx:id="boutonSupprimer" text="Supprimer" styleClass="bouton-danger" maxWidth="Infinity"
                    onAction="#supprimer"/>
        </VBox>
    </HBox>
</VBox>
