<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.emsi.coaching.controller.AdminAlimentsController" spacing="16">

    <Label text="Catalogue des aliments" styleClass="titre-page"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <HBox spacing="10" styleClass="barre-outils">
                <TextField fx:id="champRecherche" promptText="Rechercher un aliment" prefWidth="180" minWidth="-Infinity"/>
                <ComboBox fx:id="filtreCategorie" prefWidth="150" minWidth="-Infinity"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Nouvel aliment" styleClass="bouton-principal" minWidth="-Infinity" onAction="#nouveau"/>
            </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="190"/>
                    <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="120"/>
                    <TableColumn fx:id="colKcal" text="kcal" prefWidth="60"/>
                    <TableColumn fx:id="colProteines" text="Prot. (g)" prefWidth="65"/>
                    <TableColumn fx:id="colGlucides" text="Gluc. (g)" prefWidth="65"/>
                    <TableColumn fx:id="colLipides" text="Lip. (g)" prefWidth="65"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
            <Label text="Valeurs nutritionnelles pour 100 g." styleClass="texte-secondaire"/>
        </VBox>

        <VBox spacing="8" styleClass="panneau-formulaire" prefWidth="300" minWidth="300">
            <Label fx:id="titreFormulaire" text="Nouvel aliment" styleClass="titre-formulaire"/>
            <Label text="Nom"/>
            <TextField fx:id="champNom"/>
            <Label text="Catégorie"/>
            <ComboBox fx:id="comboCategorie" editable="true"/>
            <Label text="Valeurs pour 100 g" styleClass="sous-titre"/>
            <GridPane hgap="10" vgap="6">
                <Label text="Calories (kcal)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="champKcal" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Protéines (g)" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="champProteines" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Glucides (g)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="champGlucides" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Lipides (g)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="champLipides" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>
            <Label fx:id="kcalCalculees" styleClass="texte-secondaire" wrapText="true"/>
            <Region prefHeight="6"/>
            <Button text="Enregistrer" styleClass="bouton-principal" maxWidth="Infinity" onAction="#enregistrer"/>
            <Button fx:id="boutonSupprimer" text="Supprimer" styleClass="bouton-danger" maxWidth="Infinity"
                    onAction="#supprimer"/>
        </VBox>
    </HBox>
</VBox>
