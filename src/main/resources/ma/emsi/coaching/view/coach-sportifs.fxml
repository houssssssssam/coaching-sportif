<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.emsi.coaching.controller.CoachSportifsController" spacing="16">

    <Label text="Mes sportifs" styleClass="titre-page"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <VBox spacing="10" HBox.hgrow="ALWAYS">
            <TextField fx:id="champRecherche" promptText="Rechercher un sportif" maxWidth="260"/>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNom" text="Sportif" prefWidth="130"/>
                    <TableColumn fx:id="colObjectif" text="Objectif" prefWidth="110"/>
                    <TableColumn fx:id="colProgramme" text="Programme actif" prefWidth="170"/>
                    <TableColumn fx:id="colPoids" text="Poids" prefWidth="70"/>
                    <TableColumn fx:id="colAssiduite" text="Assiduité" prefWidth="80"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>

        <ScrollPane fitToWidth="true" prefWidth="340" minWidth="340" style="-fx-background-color: transparent;">
            <VBox fx:id="panneauDetail" spacing="8" styleClass="panneau-formulaire">
                <Label fx:id="titreDetail" text="Sélectionnez un sportif" styleClass="titre-formulaire"/>

                <Label text="Profil" styleClass="sous-titre"/>
                <Label fx:id="texteProfil" wrapText="true"/>

                <Label text="Objectif nutritionnel" styleClass="sous-titre"/>
                <Label fx:id="texteNutrition" wrapText="true"/>

                <Label text="Suivi (4 dernières semaines)" styleClass="sous-titre"/>
                <Label fx:id="texteSuivi" wrapText="true"/>

                <Button fx:id="boutonTableauBord" text="Voir le tableau de bord" styleClass="bouton-secondaire"
                        maxWidth="Infinity" onAction="#ouvrirTableauBord"/>

                <Label text="Affecter un programme" styleClass="sous-titre"/>
                <ComboBox fx:id="comboProgramme"/>
                <DatePicker fx:id="champDateDebut"/>
                <HBox spacing="8">
                    <Button fx:id="boutonAffecter" text="Affecter" styleClass="bouton-principal"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#affecter"/>
                    <Button fx:id="boutonTerminer" text="Terminer l'actuel" styleClass="bouton-danger"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#terminer"/>
                </HBox>

                <Label text="Historique des programmes" styleClass="sous-titre"/>
                <ListView fx:id="listeHistorique" prefHeight="110"/>
            </VBox>
        </ScrollPane>
    </HBox>
</VBox>
