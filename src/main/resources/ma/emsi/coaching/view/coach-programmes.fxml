<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.emsi.coaching.controller.CoachProgrammesController" spacing="16">

    <Label text="Mes programmes" styleClass="titre-page"/>

    <HBox spacing="20" VBox.vgrow="ALWAYS">
        <!-- Liste des programmes -->
        <VBox spacing="10" prefWidth="210" minWidth="210">
            <Button text="Nouveau programme" styleClass="bouton-principal" maxWidth="Infinity" onAction="#nouveauProgramme"/>
            <ListView fx:id="listeProgrammes" VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Détail du programme sélectionné -->
        <TabPane fx:id="onglets" tabClosingPolicy="UNAVAILABLE" HBox.hgrow="ALWAYS">
            <Tab text="Informations">
                <VBox spacing="8" styleClass="panneau-formulaire">
                    <Label fx:id="titreProgramme" text="Nouveau programme" styleClass="titre-formulaire"/>
                    <Label text="Nom"/>
                    <TextField fx:id="champNom"/>
                    <Label text="Description"/>
                    <TextArea fx:id="champDescription" prefRowCount="3" wrapText="true"/>
                    <HBox spacing="12">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Objectif"/>
                            <ComboBox fx:id="comboObjectif" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Niveau"/>
                            <ComboBox fx:id="comboNiveau" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                    <Region prefHeight="6"/>
                    <HBox spacing="10">
                        <Button text="Enregistrer le programme" styleClass="bouton-principal" onAction="#enregistrerProgramme"/>
                        <Button fx:id="boutonSupprimerProgramme" text="Supprimer" styleClass="bouton-danger"
                                onAction="#supprimerProgramme"/>
                    </HBox>
                </VBox>
            </Tab>

            <Tab fx:id="ongletExercices" text="Exercices du programme">
                <HBox spacing="16">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <TableView fx:id="tableLignes" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colJour" text="Jour" prefWidth="45" maxWidth="60"/>
                                <TableColumn fx:id="colExercice" text="Exercice" prefWidth="160"/>
                                <TableColumn fx:id="colDetail" text="Détail" prefWidth="150"/>
                                <TableColumn fx:id="colConsigne" text="Consigne" prefWidth="140"/>
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>
                        </TableView>
                        <Label fx:id="resumeProgramme" styleClass="texte-secondaire"/>
                    </VBox>

                    <VBox spacing="8" styleClass="panneau-formulaire" prefWidth="270" minWidth="270">
                        <Label fx:id="titreLigne" text="Ajouter un exercice" styleClass="titre-formulaire"/>
                        <Label text="Exercice"/>
                        <ComboBox fx:id="comboExercice"/>
                        <GridPane hgap="10" vgap="6">
                            <Label minWidth="-Infinity" text="Jour (1-7)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="comboJour" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label minWidth="-Infinity" text="Ordre" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="champOrdre" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label minWidth="-Infinity" fx:id="labelSeries" text="Séries" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <TextField fx:id="champSeries" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label minWidth="-Infinity" fx:id="labelReps" text="Répétitions" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <TextField fx:id="champReps" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label minWidth="-Infinity" fx:id="labelCharge" text="Charge (kg)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <TextField fx:id="champCharge" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                            <Label minWidth="-Infinity" fx:id="labelDuree" text="Durée (min)" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <TextField fx:id="champDuree" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                        </GridPane>
                        <Label text="Consigne (facultatif)"/>
                        <TextField fx:id="champConsigne"/>
                        <Region prefHeight="4"/>
                        <Button text="Enregistrer la ligne" styleClass="bouton-principal" maxWidth="Infinity"
                                onAction="#enregistrerLigne"/>
                        <HBox spacing="8">
                            <Button text="Nouvelle ligne" styleClass="bouton-secondaire" maxWidth="Infinity"
                                    HBox.hgrow="ALWAYS" onAction="#nouvelleLigne"/>
                            <Button fx:id="boutonSupprimerLigne" text="Retirer" styleClass="bouton-danger"
                                    maxWidth="Infinity" HBox.hgrow="ALWAYS" onAction="#supprimerLigne"/>
                        </HBox>
                    </VBox>
                </HBox>
            </Tab>
        </TabPane>
    </HBox>
</VBox>
