<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ma.emsi.coaching.controller.LoginController"
      alignment="CENTER" spacing="14" styleClass="page-login">
    <padding>
        <Insets top="40" right="50" bottom="40" left="50"/>
    </padding>

    <Label text="Coaching sportif" styleClass="titre-login"/>
    <Label text="Connectez-vous à votre espace" styleClass="texte-secondaire"/>

    <VBox spacing="6">
        <Label text="Email"/>
        <TextField fx:id="champEmail" promptText="exemple@coaching.ma"/>
    </VBox>
    <VBox spacing="6">
        <Label text="Mot de passe"/>
        <PasswordField fx:id="champMotDePasse" promptText="Mot de passe"/>
    </VBox>

    <Label fx:id="messageErreur" styleClass="message-erreur" wrapText="true"/>

    <Button fx:id="boutonConnexion" text="Se connecter" defaultButton="true"
            maxWidth="Infinity" styleClass="bouton-principal" onAction="#seConnecter"/>
</VBox>
